# Copy to .env and fill in. Never commit the real .env.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=

# Default channel ID where alerts (and ban cards) are posted. Right-click the
# channel -> Copy Channel ID (Developer Mode must be on in Discord settings).
# Only applies to the server that channel actually lives in.
MOD_LOG_CHANNEL_ID=

# Per-server mod-log routing, for one bot in several servers:
#   MOD_LOG_CHANNELS=<guild_id>:<channel_id>,<guild_id>:<channel_id>
# Takes precedence over MOD_LOG_CHANNEL_ID for the servers it names. Any server
# listed in neither falls back to a channel named avatar-shield / mod-log /
# alerts (etc.) that the bot can post in.
MOD_LOG_CHANNELS=

# false = alert-only (never touches anyone). true = auto-ban ban-tier matches.
# If true, the bot role needs Ban Members and must sit ABOVE the roles it bans.
ENFORCE_BAN=false

# Post a one-line "online, watching N admin avatars" card to each server's
# mod-log at boot, so a quiet server still proves the bot is wired up.
STARTUP_NOTICE=true

# Hamming-distance thresholds (out of 64 bits). Lower = stricter.
#   <= THRESHOLD_BAN   -> ban tier
#   <= THRESHOLD_ALERT -> alert tier (review)
THRESHOLD_BAN=6
THRESHOLD_ALERT=10
