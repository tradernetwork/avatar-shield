# Copy to .env and fill in. Never commit the real .env.
#
# NOTE: as of the self-serve release, any server owner can configure Avatar
# Shield for their own server with /shield slash commands in Discord — no env
# edit, no redeploy. Everything below is only the DEFAULT/FALLBACK behaviour
# for servers that haven't run /shield setup for themselves yet, plus the
# settings this specific deployment's operator needs.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=

# Where per-server settings (/shield setup, /shield mode, /shield protect...)
# are persisted, as a SQLite file. On Railway/Fly/Docker, mount a PERSISTENT
# VOLUME at this path's directory or every setting is lost on the next
# restart/redeploy. If this directory isn't writable, the bot falls back to
# ./avatar-shield.db next to the code (not persisted across deploys) and logs
# a warning — it still runs, it just won't remember settings.
AVATAR_SHIELD_DB=/data/avatar-shield.db

# Default channel ID where alerts (and ban cards) are posted, for servers that
# haven't run /shield setup. Right-click the channel -> Copy Channel ID
# (Developer Mode must be on in Discord settings). Only applies to the server
# that channel actually lives in.
MOD_LOG_CHANNEL_ID=

# Per-server mod-log routing, for one bot in several servers that haven't
# self-configured via /shield setup:
#   MOD_LOG_CHANNELS=<guild_id>:<channel_id>,<guild_id>:<channel_id>
# Takes precedence over MOD_LOG_CHANNEL_ID for the servers it names. Any server
# listed in neither, and that hasn't run /shield setup, falls back to a
# channel named avatar-shield / mod-log / alerts (etc.) that the bot can post in.
MOD_LOG_CHANNELS=

# Extra faces to protect in EVERY server, beyond whoever holds Administrator.
# Comma-separated user IDs. Use this when the person being impersonated isn't
# staff in the server doing the watching — a community owner in a friend's
# server, say. Never flagged themselves. (Per-server equivalent: /shield protect.)
PROTECTED_USER_IDS=

# Default mode for servers that haven't run /shield mode. false = alert-only
# (never touches anyone). true = auto-ban ban-tier matches. If true, the bot
# role needs Ban Members and must sit ABOVE the roles it bans.
ENFORCE_BAN=false

# Post a one-line "online, watching N admin avatars" card to each server's
# mod-log at boot, so a quiet server still proves the bot is wired up.
STARTUP_NOTICE=true

# Hamming-distance thresholds (out of 64 bits). Lower = stricter.
#   <= THRESHOLD_BAN   -> ban tier
#   <= THRESHOLD_ALERT -> alert tier (review)
THRESHOLD_BAN=6
THRESHOLD_ALERT=10
