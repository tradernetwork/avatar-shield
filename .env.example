# Copy to .env and fill in. Never commit the real .env.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=

# Channel ID where alerts (and ban cards) are posted. Right-click the channel
# -> Copy Channel ID (Developer Mode must be on in Discord settings).
MOD_LOG_CHANNEL_ID=

# false = alert-only (never touches anyone). true = auto-ban ban-tier matches.
# If true, the bot role needs Ban Members and must sit ABOVE the roles it bans.
ENFORCE_BAN=false

# Hamming-distance thresholds (out of 64 bits). Lower = stricter.
#   <= THRESHOLD_BAN   -> ban tier
#   <= THRESHOLD_ALERT -> alert tier (review)
THRESHOLD_BAN=6
THRESHOLD_ALERT=10
